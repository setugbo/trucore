# Database
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# SMTP Configuration
SMTP_HOST="your-smtp-host.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-user@domain.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="TRUCORE <noreply@domain.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TRUCORE"

# Required by scripts/seed.js and scripts/seed-demo.js - the password set on
# every demo/seeded account. Never set this in a real production environment.
SEED_ADMIN_PASSWORD=""

# Must be explicitly set to "true" for /api/admin/seed-demo to run at all.
# That route WIPES ALL DATA and reseeds fixed demo accounts - leave this
# unset (or "false") in any environment that holds real data.
ALLOW_DESTRUCTIVE_SEED="false"
